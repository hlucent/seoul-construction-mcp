# 이 파일은 예시입니다. 실제 값은 이 파일을 복사해서 .env로 만들고 채우세요.
# .env는 .gitignore에 포함되어 있어서 깃허브에 올라가지 않습니다.

SEOUL_OPENAPI_KEY=<YOUR_SEOUL_OPENAPI_KEY>

# 로컬 실행: 비워두면 인증 생략(본인만 쓰는 로컬 환경이므로 무인증 허용).
# 웹 배포: 값을 채우면(fly secrets set MCP_ACCESS_KEY=...) 자동으로 ?key= 인증이 활성화됨.
MCP_ACCESS_KEY=

# local(기본값): rate limit 없음. web: 분당/일일 호출 제한 등 기존 rate limit 그대로 적용.
DEPLOY_MODE=local

# 로컬 실행 포트(기본 8080). 운영 중인 웹 서버와 충돌 방지를 위해 로컬 테스트 시 8001 등으로 변경 가능.
PORT=8001
